{
  "$schema": "https://gofastmcp.com/public/schemas/fastmcp.json/v1.json",
  "source": {
    "type": "filesystem",
    "path": "server.py",
    "entrypoint": "mcp"
  },
  "environment": {
    "type": "uv",
    "python": ">=3.11",
    "dependencies": [
      "fastmcp>=4.2.0",
      "pydantic>=2.8.0",
      "fastapi>=0.115.0",
      "uvicorn>=0.30.0",
      "python-multipart>=0.0.9",
      "httpx>=0.27.0"
    ]
  },
  "deployment": {
    "transport": "http",
    "host": "0.0.0.0",
    "port": 8000,
    "log_level": "INFO"
  }
}
